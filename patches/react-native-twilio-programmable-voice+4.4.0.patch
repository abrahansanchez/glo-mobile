+RCT_REMAP_METHOD(rejectCallInvite,
+                 rejectCallInviteWithCallSid:(NSString *)callSid
+                 rejectCallInviteResolver:(RCTPromiseResolveBlock)resolve
+                 rejectCallInviteRejecter:(RCTPromiseRejectBlock)reject) {
+    TVOCallInvite *matchingInvite = nil;
+    for (NSString *activeCallInviteId in self.activeCallInvites) {
+        TVOCallInvite *candidate = [self.activeCallInvites objectForKey:activeCallInviteId];
+        if ([candidate.callSid isEqualToString:callSid]) {
+            matchingInvite = candidate;
+            break;
+        }
+    }
+
+    if (!matchingInvite) {
+        resolve(@{ @"rejected": @NO, @"reason": @"invite_not_found" });
+        return;
+    }
+
+    NSUUID *inviteUUID = matchingInvite.uuid;
+    @synchronized ([RNTwilioVoice class]) {
+        if (!PendingInviteRejectionUUIDs) {
+            PendingInviteRejectionUUIDs = [NSMutableSet set];
+        }
+        [PendingInviteRejectionUUIDs addObject:inviteUUID.UUIDString];
+    }
+    CXEndCallAction *endCallAction = [[CXEndCallAction alloc] initWithCallUUID:inviteUUID];
+    CXTransaction *transaction = [[CXTransaction alloc] initWithAction:endCallAction];
+    [self.callKitCallController requestTransaction:transaction completion:^(NSError *error) {
+        if (error) {
+            @synchronized ([RNTwilioVoice class]) {
+                [PendingInviteRejectionUUIDs removeObject:inviteUUID.UUIDString];
+            }
+            reject(@"CALLKIT_REJECT_FAILED", [error localizedDescription], error);
+            return;
+        }
+        resolve(@{ @"rejected": @YES });
+    }];
+}
